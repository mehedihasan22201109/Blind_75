class Solution:
    def longestConsecutive(self, nums):
        remaining = set(nums)
        longest_streak = 0

        while remaining:
            starting_number = remaining.pop()
            streak_length = 1

            left_number = starting_number - 1
            while left_number in remaining:
                remaining.remove(left_number)
                streak_length += 1
                left_number -= 1

            right_number = starting_number + 1
            while right_number in remaining:
                remaining.remove(right_number)
                streak_length += 1
                right_number += 1

            longest_streak = max(longest_streak, streak_length)

        return longest_streak
