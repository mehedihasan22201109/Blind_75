class Solution:
    def lengthOfLongestSubstring(self, s):
        last_seen = {}
        window_start = 0
        longest_length = 0

        for position, character in enumerate(s):
            previous_position = last_seen.get(character, -1)

            if previous_position >= window_start:
                window_start = previous_position + 1

            last_seen[character] = position
            current_length = position - window_start + 1
            longest_length = max(longest_length, current_length)

        return longest_length
